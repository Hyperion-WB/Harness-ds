{
  "name": "deepseek-harness-gui",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "description": "Tauri desktop shell for DeepSeek Harness (dsh web)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hyperion-WB/Harness-ds.git"
  },
  "homepage": "https://github.com/Hyperion-WB/Harness-ds",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "DSH_GUI_SMOKE=1 vitest run src/shared/dshWeb.smoke.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "icons": "bash scripts/generate-icons.sh"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-global-shortcut": "^2.3.2",
    "@tauri-apps/plugin-opener": "^2",
    "highlight.js": "^11.12.0",
    "lucide-react": "^0.525.0",
    "marked": "^18.0.9",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "jsdom": "^26.1.0",
    "sass": "^1.89.2",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^3.2.4"
  }
